# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase (used as plain Postgres + Storage, NOT Supabase Auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never exposed to client — used for Storage signed URLs
DATABASE_URL=                        # Supabase Session Pooler connection string, used by Drizzle

# Redis (queue) — local: redis://localhost:6379 after `docker compose up -d`
REDIS_URL=redis://localhost:6379

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
WEB_APP_URL=http://localhost:5173

# LLM (match scorer)
# Prefer college/OpenAI credits: set OPENAI_API_KEY and MOCK_MATCH_SCORER=false
# Anthropic (Claude) is optional if you pay for console.anthropic.com
OPENAI_API_KEY=
# OpenRouter college keys (sk-or-...): use openai/gpt-4o-mini
# Direct OpenAI keys (sk-...): use gpt-4o-mini
OPENAI_MODEL=openai/gpt-4o-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
MOCK_MATCH_SCORER=false

# Worker
WORKER_INTERNAL_URL=http://localhost:8000
# Optional on the worker service too (for refining title/company from hard pages):
# OPENAI_API_KEY=
# OPENAI_MODEL=openai/gpt-4o-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
